# MarketLens production configuration (used by docker-compose.yml).
# Copy to .env, fill in the values, and keep it private: `chmod 600 .env`.
# Never commit .env to Git (it is listed in .gitignore).

# --- Database (PostgreSQL container) ---------------------------------------------------
POSTGRES_DB=marketlens
POSTGRES_USER=marketlens
# Use a long random value without URL-special characters, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string

# --- Market data -------------------------------------------------------------------------
# Stocks / ETFs / indices: free key from https://twelvedata.com/pricing (leave empty to run crypto-only).
TWELVEDATA_API_KEY=
# Match these to your Twelve Data plan (Basic/free: 8 per minute, 800 per day).
TWELVEDATA_CREDITS_PER_MINUTE=8
TWELVEDATA_CREDITS_PER_DAY=800
# Crypto comes from Coinbase Exchange public market data (no key needed).
COINBASE_ENABLED=true

# --- API behaviour -----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_API_DOCS=true
# Requests per minute per client IP (Nginx also rate-limits).
RATE_LIMIT_PER_MINUTE=240
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=

# --- Cache TTLs (seconds) ------------------------------------------------------------------
QUOTE_TTL_CRYPTO=4
QUOTE_TTL_EQUITY=60

# --- Host port the frontend container listens on (bound to 127.0.0.1 only) -----------------
HTTP_PORT=8080
