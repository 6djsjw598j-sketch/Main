[Unit]
Description=Level Mount Co. website (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=levelmount
Group=levelmount
WorkingDirectory=/opt/levelmount/app
EnvironmentFile=/etc/levelmount.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3

# Hardening: the app only needs to read its code and write its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
StateDirectory=levelmount
ReadWritePaths=/var/lib/levelmount
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
