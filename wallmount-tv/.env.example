# Copy to .env and edit. All values are optional except ADMIN_TOKEN in production.

# Port the Node server listens on. Nginx proxies to it.
PORT=3000
# 127.0.0.1 when Nginx runs on the same host; 0.0.0.0 inside Docker.
HOST=127.0.0.1

# Where quote requests are stored (JSON Lines). Must be writable.
DATA_DIR=./data

# Bearer token for GET /api/quotes (list/export submissions). Generate with:
#   openssl rand -hex 32
# Leave empty to disable the endpoint.
ADMIN_TOKEN=

# Set to 1 when running behind Nginx so the client IP comes from X-Forwarded-For.
TRUST_PROXY=1

# Max quote submissions per IP per 10 minutes.
QUOTE_RATE_LIMIT=5
