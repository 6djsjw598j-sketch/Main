# optionsbot secrets. Copy to .env (never commit it) and `chmod 600 .env`.

# Alpaca API keys: https://app.alpaca.markets -> Paper Trading -> API Keys.
# Paper keys only work against the paper endpoint, which is the default.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional: free key from https://finnhub.io for earnings dates (needed to trade single stocks).
FINNHUB_API_KEY=

# Optional: Slack or Discord incoming-webhook URL for trade and alert notifications.
NOTIFY_WEBHOOK_URL=

# Live trading needs BOTH `mode: live` in config.yaml AND this exact phrase:
#   OPTIONSBOT_LIVE_CONFIRMATION=I understand this bot trades real money
OPTIONSBOT_LIVE_CONFIRMATION=
