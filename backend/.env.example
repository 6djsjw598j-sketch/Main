# Local development settings for running the API directly with uvicorn (see README).
APP_ENV=development
DEBUG=false
LOG_JSON=false
LOG_LEVEL=INFO
# SQLite file for local development; production uses PostgreSQL via docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./data/marketlens.db
# Optional: REDIS_URL=redis://localhost:6379/0  (an in-memory cache is used when empty)
REDIS_URL=
# Free key from https://twelvedata.com/pricing enables stocks/ETFs/indices. Crypto works without it.
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MINUTE=8
TWELVEDATA_CREDITS_PER_DAY=800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
